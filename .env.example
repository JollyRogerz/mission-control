# ============================================================
# Mission Control — environment configuration
# Copy to `.env` (setup.sh does this automatically) and fill in.
# NEVER commit your real `.env` — it is gitignored.
# ============================================================

# ── Bridge server ───────────────────────────────────────────
# FastAPI bind host & port (defaults are local-only)
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8100
# Auth token for the bridge HTTP API (generate: `openssl rand -hex 32`)
BRIDGE_AUTH_TOKEN=

# ── Gateway (OpenClaw runtime) ──────────────────────────────
# WebSocket URL for the agent runtime gateway
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
# Gateway auth token (BRIDGE_AUTH_TOKEN takes precedence if both set)
OPENCLAW_GATEWAY_TOKEN=
# Docker binary path & container name (Linux/CI: leave DOCKER_BIN unset)
DOCKER_BIN=docker
DOCKER_CONTAINER=openclaw-gateway
# Per-agent sessions directory inside the gateway container
SESSIONS_DIR=/home/node/.openclaw/agents

# ── Model providers (Phase 4 adapters — fill the ones you use) ──
# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# OpenRouter (multi-model gateway)
OPENROUTER_API_KEY=
# Ollama (local; no API key needed)
OLLAMA_HOST=http://127.0.0.1:11434

# ── Integrations (Phase 4 adapters — fill the ones you use) ─
# Discord (bot token from https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=
# Telegram (bot token from @BotFather)
TELEGRAM_BOT_TOKEN=
# Default chat for Telegram sends (channel/group ID, e.g. -1001234567890)
TELEGRAM_DEFAULT_CHAT_ID=
# Operator chat (alerts to a single operator account)
TELEGRAM_OPERATOR_CHAT_ID=
